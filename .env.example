# ============================================================
# TELEGRAM PUBLISHER — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# ── Bot ─────────────────────────────────────────────────────
BOT_TOKEN=1072317583:AAHcVh1MIiu54ajh_aYHRvAQJFUocVECqAI
BOT_USERNAME=abi35bot

# ── Admin ───────────────────────────────────────────────────
# Comma-separated Telegram user IDs of initial super-admins
ADMIN_IDS=7839563863,8790314619

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/telegram_publisher
# Lightweight dev mode (SQLite): sqlite+aiosqlite:///./publisher.db

# ── Redis / Queue ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── API / Web ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Webhook ──────────────────────────────────────────────────
# Leave empty to use long-polling (good for dev/Termux)
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/webhook

# ── AI Provider (optional) ───────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Storage ──────────────────────────────────────────────────
STORAGE_PROVIDER=local
LOCAL_MEDIA_PATH=./media
# S3:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# ── Timezone ─────────────────────────────────────────────────
DEFAULT_TIMEZONE=Africa/Addis_Ababa

# ── Feature Flags ────────────────────────────────────────────
FEATURE_AI=false
FEATURE_ANALYTICS=true
FEATURE_MINI_APP=false
FEATURE_AUTOMATION=true
FEATURE_INLINE=true
FEATURE_CAMPAIGNS=true
FEATURE_AB_TESTING=false
FEATURE_MONITORING=false
FEATURE_RICH_MESSAGES=true
FEATURE_EPHEMERAL=false
FEATURE_COMMUNITIES=false

# ── Dev / Safety ─────────────────────────────────────────────
DRY_RUN=false
LOG_LEVEL=INFO
ENVIRONMENT=production
# ENVIRONMENT=development
